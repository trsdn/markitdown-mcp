{
  "name": "convert_directory",
  "description": "Convert all supported files in a directory to Markdown",
  "input_schema": {
    "type": "object",
    "properties": {
      "input_directory": {
        "type": "string",
        "description": "Path to the input directory"
      },
      "output_directory": {
        "type": "string",
        "description": "Path to the output directory (optional)"
      }
    },
    "required": [
      "input_directory"
    ]
  },
  "required_args": [
    "input_directory"
  ],
  "optional_args": [
    "output_directory"
  ]
}